{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    ':maintainLockFilesMonthly',
  ],
  schedule: ['before 6am on monday'],
  labels: ['dependencies'],
  prConcurrentLimit: 5,
  // Give the registry time to pull compromised or broken releases
  minimumReleaseAge: '3 days',
  vulnerabilityAlerts: {
    labels: ['dependencies', 'security'],
    schedule: ['at any time'],
    minimumReleaseAge: null,
  },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      // Majors are opened from the Dependency Dashboard on demand
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      groupName: 'GitHub Actions',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
    },
    {
      groupName: 'server dev dependencies (non-major)',
      matchFileNames: ['package.json'],
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      groupName: 'client @types (non-major)',
      matchFileNames: ['client/package.json'],
      matchPackageNames: ['@types/**'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      // typescript-eslint 8 supports TypeScript <6.1
      matchFileNames: ['client/package.json'],
      matchPackageNames: ['typescript'],
      allowedVersions: '<6.1',
    },
    {
      // react-beautiful-dnd doesn't support React 19
      matchFileNames: ['client/package.json'],
      matchPackageNames: ['react', 'react-dom', '@types/react', '@types/react-dom'],
      allowedVersions: '<19',
    },
  ],
}
